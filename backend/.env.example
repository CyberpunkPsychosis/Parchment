# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）

# JWT 签名密钥（生产环境务必改成随机长字符串）
JWT_SECRET=dev-change-me-please

# 免费档模型 key —— 智谱 GLM-4-Flash（免费申请：https://open.bigmodel.cn）
# 不填也能跑：后端会用"假回声"模式，方便先把链路调通
ZHIPU_API_KEY=

# 会员档模型 key —— DeepSeek（https://platform.deepseek.com），Phase 4 才用
DEEPSEEK_API_KEY=

# 文生图 key —— 即梦/火山方舟 Seedream，Phase 5 才用
ARK_API_KEY=
